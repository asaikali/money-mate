{
  "local": {
    "baseUrl": "http://localhost:8083",
    "Security": {
      "Auth": {
        "identity-broker": {
          "Type": "OAuth2",
          "Grant Type": "Authorization Code",
          "Auth URL": "http://localhost:9000/oauth2/authorize",
          "Token URL": "http://localhost:9000/oauth2/token",
          "Client ID": "intellij-http-client",
